{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Metric name (e.g. Callback Rate, Lost Revenue)"
    },
    {
      "displayName": "Now Value",
      "name": "nowValue",
      "kind": "Measure",
      "requiredTypes": [
        {
          "numeric": true
        }
      ],
      "description": "Current period value"
    },
    {
      "displayName": "Then Value",
      "name": "thenValue",
      "kind": "Measure",
      "requiredTypes": [
        {
          "numeric": true
        }
      ],
      "description": "Baseline period value"
    },
    {
      "displayName": "Format",
      "name": "format",
      "kind": "Measure",
      "description": "Display format per row: number, currency, or percent"
    },
    {
      "displayName": "Direction",
      "name": "direction",
      "kind": "Measure",
      "description": "Colour semantics per row: upIsGood or downIsGood"
    },
    {
      "displayName": "Sort Order",
      "name": "sortOrder",
      "kind": "Measure",
      "description": "Optional numeric field to control display order"
    }
  ],
  "objects": {
    "comparisonSettings": {
      "properties": {
        "positiveColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Positive Color"
        },
        "negativeColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Negative Color"
        },
        "neutralColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Neutral Color"
        },
        "connectorWidth": {
          "type": {
            "numeric": true
          },
          "displayName": "Connector Width"
        },
        "dotRadius": {
          "type": {
            "numeric": true
          },
          "displayName": "Dot Radius"
        },
        "animationDuration": {
          "type": {
            "numeric": true
          },
          "displayName": "Animation Duration"
        },
        "staggerDelay": {
          "type": {
            "numeric": true
          },
          "displayName": "Stagger Delay"
        },
        "showVarianceBadge": {
          "type": {
            "bool": true
          },
          "displayName": "Show Variance Badge"
        },
        "varianceFormat": {
          "type": {
            "enumeration": [
              {
                "displayName": "Percentage",
                "value": "percent"
              },
              {
                "displayName": "Absolute",
                "value": "absolute"
              },
              {
                "displayName": "Both",
                "value": "both"
              }
            ]
          },
          "displayName": "Variance Format"
        },
        "valueFormat": {
          "type": {
            "enumeration": [
              {
                "displayName": "Auto",
                "value": "auto"
              },
              {
                "displayName": "Number",
                "value": "number"
              },
              {
                "displayName": "Percent",
                "value": "percent"
              },
              {
                "displayName": "Currency",
                "value": "currency"
              }
            ]
          },
          "displayName": "Value Format"
        },
        "decimalPlaces": {
          "type": {
            "numeric": true
          },
          "displayName": "Decimal Places"
        }
      },
      "displayName": "Comparison Settings"
    },
    "labelSettings": {
      "properties": {
        "categoryFontSize": {
          "type": {
            "numeric": true
          },
          "displayName": "Category Font Size"
        },
        "categoryColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Category Color"
        },
        "valueFontSize": {
          "type": {
            "numeric": true
          },
          "displayName": "Value Font Size"
        },
        "valueColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Value Color"
        },
        "badgeFontSize": {
          "type": {
            "numeric": true
          },
          "displayName": "Badge Font Size"
        },
        "nowLabel": {
          "type": {
            "text": true
          },
          "displayName": "Now Label"
        },
        "thenLabel": {
          "type": {
            "text": true
          },
          "displayName": "Then Label"
        },
        "showLabels": {
          "type": {
            "bool": true
          },
          "displayName": "Show Labels"
        },
        "endpointLabelFontSize": {
          "type": {
            "numeric": true
          },
          "displayName": "Endpoint Label Font Size"
        },
        "endpointLabelBold": {
          "type": {
            "bool": true
          },
          "displayName": "Endpoint Label Bold"
        },
        "endpointLabelColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Endpoint Label Color"
        }
      },
      "displayName": "Label Settings"
    },
    "styleSettings": {
      "properties": {
        "backgroundColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Background Color"
        },
        "trackColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "displayName": "Track Color"
        },
        "trackHeight": {
          "type": {
            "numeric": true
          },
          "displayName": "Track Height"
        },
        "rowSpacing": {
          "type": {
            "numeric": true
          },
          "displayName": "Row Spacing"
        }
      },
      "displayName": "Style Settings"
    },
    "axisSettings": {
      "properties": {
        "axisMode": {
          "type": {
            "enumeration": [
              {
                "displayName": "Shared (single scale)",
                "value": "shared"
              },
              {
                "displayName": "Independent per category",
                "value": "perCategory"
              }
            ]
          },
          "displayName": "Axis Mode"
        },
        "perCategoryPadding": {
          "type": {
            "numeric": true
          },
          "displayName": "Per Category Padding"
        },
        "showAxisTitles": {
          "type": {
            "bool": true
          },
          "displayName": "Show Axis Titles"
        },
        "xAxisTitle": {
          "type": {
            "text": true
          },
          "displayName": "X Axis Title"
        },
        "yAxisTitle": {
          "type": {
            "text": true
          },
          "displayName": "Y Axis Title"
        }
      },
      "displayName": "Axis Settings"
    },
    "background": {
      "displayName": "Background",
      "properties": {
        "backgroundColor": {
          "displayName": "Background Colour",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "transparency": {
          "displayName": "Transparency",
          "type": {
            "numeric": true
          }
        }
      }
    }
  },
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "nowValue": {
            "max": 1
          },
          "thenValue": {
            "max": 1
          },
          "format": {
            "max": 1
          },
          "direction": {
            "max": 1
          },
          "sortOrder": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "nowValue"
              }
            },
            {
              "bind": {
                "to": "thenValue"
              }
            },
            {
              "bind": {
                "to": "format"
              }
            },
            {
              "bind": {
                "to": "direction"
              }
            },
            {
              "bind": {
                "to": "sortOrder"
              }
            }
          ]
        }
      }
    }
  ],
  "privileges": [],
  "supportsHighlight": true,
  "supportsKeyboardFocus": true,
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsMultiVisualSelection": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    }
  }
}
